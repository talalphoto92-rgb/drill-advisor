      <div class="oil-lane-wrap" id="olw-short">
        <canvas id="olc-short" height="90"></canvas>
        <div class="oil-lane-badge" id="olb-short"></div>
        <div class="oil-lane-label" id="oll-short">Short 33–37ft</div>
      </div>
      <div class="oil-lane-wrap" id="olw-medium">
        <canvas id="olc-medium" height="90"></canvas>
        <div class="oil-lane-badge" id="olb-medium"></div>
        <div class="oil-lane-label" id="oll-medium">Medium 38–42ft</div>
      </div>
      <div class="oil-lane-wrap" id="olw-long">
        <canvas id="olc-long" height="90"></canvas>
        <div class="oil-lane-badge" id="olb-long"></div>
        <div class="oil-lane-label" id="oll-long">Long 43–47ft</div>
      </div>
      <div class="oil-lane-wrap" id="olw-sport">
        <canvas id="olc-sport" height="90"></canvas>
        <div class="oil-lane-badge" id="olb-sport"></div>
        <div class="oil-lane-label" id="oll-sport">Sport / Flat</div>
      </div>
    </div>

    <div class="drill-recs">
      <div class="drill-recs-title">Recommended Layouts</div>
      <div id="mLayouts"></div>
    </div>
    <div class="desc-text" id="mDesc"></div>
    <button class="close-btn" id="closeModal">Close</button>
  </div>
</div>

<!-- BOTTOM NAV -->
<div class="nav">
  <button class="nav-btn active" id="nav-advisor">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="15" x2="12" y2="16"></line></svg>
    Advisor
  </button>
  <button class="nav-btn" id="nav-balls">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M8 12 q2-4 4 0"></path><path d="M12 9 q4 2 0 4"></path></svg>
    Motiv Balls
  </button>
</div>




</body></html>
