@charset "utf-8";

:root { --bg: #08080f; --surface: #111118; --card: #181825; --border: #252535; --accent: #e8b84b; --blue: #4b7be8; --green: #4be87a; --red: #e84b6e; --purple: #a64be8; --text: #e8e8f4; --muted: #666680; --safe-bottom: env(safe-area-inset-bottom, 16px); }

* { box-sizing: border-box; margin: 0px; padding: 0px; -webkit-tap-highlight-color: transparent; }

html, body { background: var(--bg); color: var(--text); font-family: "DM Sans", sans-serif; min-height: 100vh; overscroll-behavior: none; }

body { padding-bottom: calc(72px + var(--safe-bottom)); }

.nav { position: fixed; bottom: 0px; left: 0px; right: 0px; background: rgb(14, 14, 26); border-top: 1px solid var(--border); display: flex; z-index: 200; padding-bottom: var(--safe-bottom); }

.nav-btn { flex: 1 1 0%; display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 10px 0px; font-size: 10px; color: var(--muted); font-weight: 500; letter-spacing: 0.5px; text-transform: uppercase; cursor: pointer; transition: color 0.15s; border: none; background: none; }

.nav-btn.active { color: var(--accent); }

.nav-btn svg { width: 20px; height: 20px; stroke: currentcolor; fill: none; stroke-width: 2; }

.page { display: none; padding: 0px 0px 8px; }

.page.active { display: block; }

.header { background: linear-gradient(135deg, rgb(13, 13, 28), rgb(20, 16, 42)); border-bottom: 1px solid var(--border); padding: 14px 16px 12px; position: sticky; top: 0px; z-index: 100; }

.header-row { display: flex; align-items: center; gap: 10px; }

.logo { font-family: "Bebas Neue", sans-serif; font-size: 24px; letter-spacing: 2px; color: var(--accent); line-height: 1; }

.logo-sub { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 1.5px; }

.section { padding: 14px 16px 0px; }

.section-label { font-size: 10px; text-transform: uppercase; letter-spacing: 2px; color: var(--muted); margin-bottom: 8px; font-weight: 600; }

.pills { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 2px; }

.pill { padding: 7px 14px; border-radius: 100px; border: 1px solid var(--border); background: var(--card); color: var(--muted); font-size: 12px; font-family: "DM Sans", sans-serif; cursor: pointer; transition: 0.15s; font-weight: 500; white-space: nowrap; }

.pill:active { transform: scale(0.97); }

.pill.on-a { background: var(--accent); border-color: var(--accent); color: rgb(0, 0, 0); font-weight: 700; }

.pill.on-b { background: var(--blue); border-color: var(--blue); color: rgb(255, 255, 255); font-weight: 700; }

.ball-card { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 16px; margin: 10px 16px 0px; display: flex; flex-direction: column; align-items: center; gap: 10px; }

.legend { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }

.leg { display: flex; align-items: center; gap: 5px; font-size: 11px; color: var(--muted); }

.dot { width: 9px; height: 9px; border-radius: 50%; }

.result-card { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 16px; margin: 10px 16px 0px; }

.r-title { font-family: "Bebas Neue", sans-serif; font-size: 20px; color: var(--accent); letter-spacing: 1px; margin-bottom: 2px; }

.r-sub { font-size: 12px; color: var(--muted); margin-bottom: 14px; }

.badge { display: inline-block; padding: 3px 10px; border-radius: 100px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; }

.badge-g { background: rgba(75, 232, 122, 0.12); color: var(--green); border: 1px solid rgba(75, 232, 122, 0.3); }

.badge-o { background: rgba(232, 184, 75, 0.12); color: var(--accent); border: 1px solid rgba(232, 184, 75, 0.3); }

.badge-b { background: rgba(232, 75, 110, 0.12); color: var(--red); border: 1px solid rgba(232, 75, 110, 0.3); }

.stat { display: flex; justify-content: space-between; align-items: center; padding: 9px 0px; border-bottom: 1px solid var(--border); font-size: 13px; }

.stat:last-child { border-bottom: none; }

.stat-l { color: var(--muted); }

.stat-v { font-weight: 600; }

.meters { margin-top: 14px; }

.m-row { margin-bottom: 10px; }

.m-head { display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 11px; }

.m-label { color: var(--muted); }

.m-val { font-weight: 600; }

.track { height: 5px; background: var(--border); border-radius: 100px; overflow: hidden; }

.fill { height: 100%; border-radius: 100px; transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1); }

.lane-card { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 14px; margin: 10px 16px 0px; }

canvas#lc { width: 100%; border-radius: 6px; }

.tip { background: linear-gradient(135deg, rgba(232, 184, 75, 0.07), rgba(75, 123, 232, 0.07)); border: 1px solid rgba(232, 184, 75, 0.2); border-radius: 16px; padding: 14px; margin: 10px 16px 0px; font-size: 12px; line-height: 1.65; color: var(--text); }

.tip strong { color: var(--accent); }

.search-wrap { padding: 12px 16px 0px; }

.search-box { width: 100%; background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 10px 14px; color: var(--text); font-family: "DM Sans", sans-serif; font-size: 14px; outline: none; }

.search-box::placeholder { color: var(--muted); }

.search-box:focus { border-color: var(--blue); }

.filter-row { display: flex; gap: 6px; padding: 10px 16px 0px; overflow-x: auto; scrollbar-width: none; }

.filter-row::-webkit-scrollbar { display: none; }

.f-btn { padding: 6px 12px; border-radius: 100px; border: 1px solid var(--border); background: var(--card); color: var(--muted); font-size: 11px; font-family: "DM Sans", sans-serif; cursor: pointer; white-space: nowrap; font-weight: 500; flex-shrink: 0; transition: 0.15s; }

.f-btn.active { background: var(--purple); border-color: var(--purple); color: rgb(255, 255, 255); font-weight: 700; }

.ball-list { padding: 8px 16px 0px; }

.ball-item { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 14px; margin-bottom: 8px; cursor: pointer; transition: border-color 0.15s; }

.ball-item:active { border-color: var(--accent); }

.bi-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }

.bi-name { font-weight: 700; font-size: 14px; }

.bi-oil { font-size: 10px; padding: 3px 8px; border-radius: 100px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }

.oil-heavy { background: rgba(75, 123, 232, 0.15); color: var(--blue); }

.oil-med-heavy { background: rgba(75, 232, 122, 0.12); color: var(--green); }

.oil-medium { background: rgba(232, 184, 75, 0.12); color: var(--accent); }

.oil-light { background: rgba(232, 75, 110, 0.12); color: var(--red); }

.bi-specs { display: flex; gap: 12px; flex-wrap: wrap; }

.bi-spec { font-size: 11px; color: var(--muted); }

.bi-spec span { color: var(--text); font-weight: 600; }

.bi-series { font-size: 11px; color: var(--purple); font-weight: 600; margin-top: 4px; }

.modal { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.85); z-index: 300; display: none; flex-direction: column; }

.modal.open { display: flex; }

.modal-inner { background: var(--surface); border-radius: 20px 20px 0px 0px; margin-top: auto; max-height: 88vh; overflow-y: auto; padding: 20px 16px calc(20px + var(--safe-bottom)); }

.modal-drag { width: 40px; height: 4px; background: var(--border); border-radius: 100px; margin: 0px auto 16px; }

.modal-title { font-family: "Bebas Neue", sans-serif; font-size: 26px; color: var(--accent); letter-spacing: 1px; margin-bottom: 2px; }

.modal-sub { font-size: 12px; color: var(--muted); margin-bottom: 16px; }

.spec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 16px; }

.spec-box { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 12px; }

.spec-box-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }

.spec-box-val { font-size: 16px; font-weight: 700; }

.desc-text { font-size: 13px; line-height: 1.7; color: rgb(192, 192, 216); margin-bottom: 16px; }

.close-btn { width: 100%; background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 13px; color: var(--text); font-size: 14px; font-family: "DM Sans", sans-serif; font-weight: 600; cursor: pointer; margin-top: 4px; }

.oil-lanes-title { font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--muted); margin-bottom: 10px; font-weight: 600; }

.oil-lanes-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 16px; }

.oil-lane-wrap { background: var(--card); border-radius: 12px; overflow: hidden; position: relative; cursor: pointer; border: 2px solid transparent; transition: border-color 0.2s; }

.oil-lane-wrap.best { border-color: var(--green); }

.oil-lane-wrap.ok-match { border-color: var(--accent); }

.oil-lane-wrap.bad-match { border-color: var(--red); opacity: 0.65; }

.oil-lane-label { position: absolute; bottom: 0px; left: 0px; right: 0px; background: rgba(0, 0, 0, 0.65); padding: 4px 6px; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; text-align: center; }

.oil-lane-badge { position: absolute; top: 4px; right: 4px; font-size: 8px; font-weight: 700; padding: 2px 5px; border-radius: 6px; text-transform: uppercase; letter-spacing: 0.3px; }

.olb-good { background: rgba(75, 232, 122, 0.25); color: var(--green); }

.olb-ok { background: rgba(232, 184, 75, 0.25); color: var(--accent); }

.olb-bad { background: rgba(232, 75, 110, 0.25); color: var(--red); }

.drill-recs { margin-bottom: 16px; }

.drill-recs-title { font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--muted); margin-bottom: 8px; font-weight: 600; }

.drill-rec { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; margin-bottom: 6px; font-size: 12px; line-height: 1.5; }

.drill-rec strong { color: var(--accent); }
