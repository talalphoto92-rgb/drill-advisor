<!-- PAGE 1: LAYOUT ADVISOR -->
<div class="page active" id="p-advisor">
  <div class="header">
    <div class="header-row">
      <div>
        <div class="logo">⚫ Drill Advisor</div>
        <div class="logo-sub">Layout × Oil Pattern Guide</div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-label">Drilling Layout</div>
    <div class="pills" id="layoutGroup">
      <button class="pill on-a" data-val="pin-up">Pin Up</button>
      <button class="pill" data-val="pin-down">Pin Down</button>
      <button class="pill" data-val="leverage">Leverage</button>
      <button class="pill" data-val="control">Control</button>
      <button class="pill" data-val="strong">Strong Angle</button>
    </div>
  </div>

  <div class="section">
    <div class="section-label">Oil Pattern</div>
    <div class="pills" id="oilGroup">
      <button class="pill on-b" data-val="short">Short 33–37ft</button>
      <button class="pill" data-val="medium">Medium 38–42ft</button>
      <button class="pill" data-val="long">Long 43–47ft</button>
      <button class="pill" data-val="sport">Sport / Flat</button>
    </div>
  </div>

  <div class="section"><div class="section-label">Ball Diagram</div></div>
  <div class="ball-card">
    <canvas id="bc" width="210" height="210"></canvas>
    <div class="legend">
      <div class="leg"><div class="dot" style="background:#e8b84b"></div>Pin</div>
      <div class="leg"><div class="dot" style="background:#4b7be8"></div>CG</div>
      <div class="leg"><div class="dot" style="background:#e84b6e"></div>PAP</div>
      <div class="leg"><div class="dot" style="background:#4be87a"></div>MB</div>
    </div>
  </div>

  <div class="section"><div class="section-label">Analysis</div></div>
  <div class="result-card">
    <div id="badge" class="badge badge-g">Excellent Match</div>
    <div class="r-title" id="rTitle">Pin Up — Short (33–37ft)</div>
    <div class="r-sub" id="rSub">Pin above fingers — arc motion, earlier roll</div>
    <div class="stat"><span class="stat-l">Pin-to-PAP</span><span class="stat-v" id="sPAP">3–4"</span></div>
    <div class="stat"><span class="stat-l">VAL Angle</span><span class="stat-v" id="sVAL">45°</span></div>
    <div class="stat"><span class="stat-l">Flare</span><span class="stat-v" id="sFlare">Medium-High</span></div>
    <div class="stat"><span class="stat-l">Motion Shape</span><span class="stat-v" id="sShape">Arc / Smooth</span></div>
    <div class="meters">
      <div class="m-row"><div class="m-head"><span class="m-label">Length</span><span class="m-val" id="mL">5/10</span></div><div class="track"><div class="fill" id="mLb" style="width: 50%; background: var(--blue);"></div></div></div>
      <div class="m-row"><div class="m-head"><span class="m-label">Backend Reaction</span><span class="m-val" id="mR">8/10</span></div><div class="track"><div class="fill" id="mRb" style="width:80%;background:var(--accent)"></div></div></div>
      <div class="m-row"><div class="m-head"><span class="m-label">Forgiveness</span><span class="m-val" id="mF">7/10</span></div><div class="track"><div class="fill" id="mFb" style="width: 70%; background: var(--green);"></div></div></div>
      <div class="m-row"><div class="m-head"><span class="m-label">Hook Potential</span><span class="m-val" id="mH">7/10</span></div><div class="track"><div class="fill" id="mHb" style="width:70%;background:var(--red)"></div></div></div>
    </div>
  </div>

  <div class="section"><div class="section-label">Lane View</div></div>
  <div class="lane-card"><canvas id="lc" width="321"></canvas></div>

  <div class="tip" id="tip"><strong>Pin Up on Short (33–37ft):</strong> Pin Up on Short Oil: Earlier roll gives a smooth, controllable arc. The ball reads friction without overshooting. Great for house shots and controllable backends.</div>
</div>

